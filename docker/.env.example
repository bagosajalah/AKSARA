=============================================
    AKSARA - Contoh Environment Variables
=============================================
CARA PAKAI:
1. Copy file ini jadi `.env`
2. Isi nilai-nilai kosong dengan milik Anda
3. JANGAN upload file `.env` ke GitHub!
=============================================

PROJECT_NAME=AKSARA Multi-Tenant Backend API
API_V1_STR=/api/v1
SECRET_KEY=CHANGE_ME_generate_strong_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== DATABASE =====
# Ganti Bagus3663 dengan password database Anda
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@database:5432/db_aksara

# ===== CORS =====
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://frontend:5173"]

# ===== REDIS =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== CHROMADB =====
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ===== LLM API KEYS =====
# Isi salah satu atau lebih (WAJIB diisi!)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===== DEFAULT LLM (FALLBACK) =====
DEFAULT_LLM_PROVIDER=google_gemini
DEFAULT_LLM_MODEL=gemini-3.6-flash

# ===== ENKRIPSI (HARUS 32 KARAKTER!) =====
ENCRYPTION_KEY=rahasiaaksarakita2026rahasia

# ===== CACHE =====
CACHE_TTL=3600
MAX_MEMORY_CACHE=1000

# ===== LOGGING =====
LOG_LEVEL=INFO
ENVIRONMENT=development
DEBUG=True